# Local development only. Do not reuse the credentials in production.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=12s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=16384

# PostgreSQL is configured in Docker Compose; connectivity is Group 3.
DB_PORT=5432
POSTGRES_DB=budget_tracker
POSTGRES_USER=budget_tracker_dev
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgres://budget_tracker_dev:change_me_local_only@localhost:5432/budget_tracker?sslmode=disable
