# LOCAL DEVELOPMENT ONLY
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_ORIGIN=http://localhost:8080
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=12s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=16384

DB_PORT=5432
POSTGRES_DB=budget_tracker
POSTGRES_USER=budget_tracker_dev
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgres://budget_tracker_dev:local_dev_only_change_me@127.0.0.1:5432/budget_tracker?sslmode=disable
DB_MIN_CONNS=0
DB_MAX_CONNS=8
DB_CONNECT_TIMEOUT=5s
DB_READY_TIMEOUT=2s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
