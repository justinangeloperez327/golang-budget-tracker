# Template only. Never commit populated production secrets.
APP_ENV=production
HTTP_ADDR=:8080
PUBLIC_ORIGIN=https://budget.example.com
LOG_LEVEL=info
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=12s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=16384
# Managed PostgreSQL: verify-full with a valid CA chain and hostname.
# Supply DATABASE_URL securely through your runtime secret manager, not this file.
# DATABASE_URL=postgres://USER:SECRET@db.example.com:5432/budget_tracker?sslmode=verify-full
DB_MIN_CONNS=0
DB_MAX_CONNS=8
DB_CONNECT_TIMEOUT=5s
DB_READY_TIMEOUT=2s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
