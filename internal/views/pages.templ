package views

templ Document(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ title } — Budget Tracker</title>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script defer src="/assets/app.js"></script>
			<script defer src="/assets/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-[var(--bg)] text-[var(--ink)] antialiased">
			<a class="skip-link" href="#main">Skip to content</a>
			@content
		</body>
	</html>
}

templ Feedback(message string) {
	<div id="auth-feedback" aria-live="polite" role="status" class="min-h-7 text-sm font-medium text-rose-600 dark:text-rose-300">
		if message != "" {
			<p>{ message }</p>
		}
	</div>
}

templ AuthPage(mode string, email string, message string) {
	@Document(authPageTitle(mode), AuthContent(mode, email, message))
}

templ AuthContent(mode string, email string, message string) {
	<main id="main" class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-5 py-12 lg:grid lg:grid-cols-2 lg:gap-20">
		<section class="mb-12 flex flex-col justify-center lg:mb-0">
			<a href="/" class="mb-12 inline-flex items-center gap-3 text-sm font-bold tracking-wide">
				<span class="flex size-10 items-center justify-center rounded-xl bg-blue-600 text-lg text-white">B</span>
				Budget Tracker
			</a>
			<p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">A clearer view of your money</p>
			<h1 class="max-w-lg text-4xl font-semibold tracking-tight sm:text-5xl">Plan carefully. Spend confidently.</h1>
			<p class="mt-5 max-w-md text-base leading-7 text-[var(--muted)]">A focused place for your income, expenses, wallets, and goals. Start with a secure personal workspace.</p>
			<p class="mt-10 text-xs text-[var(--muted)]">AED and PHP accounting · Private by default</p>
		</section>
		<section class="flex items-center">
			<div class="w-full rounded-2xl border border-[var(--border)] bg-[var(--panel)] p-6 shadow-sm sm:p-9">
				if mode == "register" {
					<h2 class="text-2xl font-semibold tracking-tight">Create an account</h2>
					<p class="mt-2 text-sm text-[var(--muted)]">Your personal workspace is created when you register.</p>
					@AuthForm("/register", "Create account", email, message, true)
					<p class="mt-5 text-sm text-[var(--muted)]">Already registered? <a class="font-semibold text-blue-600 hover:underline" href="/login">Sign in</a></p>
				} else {
					<h2 class="text-2xl font-semibold tracking-tight">Welcome back</h2>
					<p class="mt-2 text-sm text-[var(--muted)]">Sign in to your budget workspace.</p>
					@AuthForm("/login", "Sign in", email, message, false)
					<p class="mt-5 text-sm text-[var(--muted)]">New here? <a class="font-semibold text-blue-600 hover:underline" href="/register">Create account</a></p>
				}
			</div>
		</section>
	</main>
}

templ AuthForm(endpoint string, submitLabel string, email string, message string, registering bool) {
	<form method="post" action={ endpoint } hx-post={ endpoint } hx-target="#auth-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-7 space-y-5">
		<div>
			<label for="email" class="mb-2 block text-sm font-medium">Email address</label>
			<input id="email" name="email" type="email" value={ email } required autocomplete="email" maxlength="254" placeholder="you@example.com" class="field"/>
		</div>
		<div>
			<label for="password" class="mb-2 block text-sm font-medium">Password</label>
			<input id="password" name="password" type="password" required autocomplete={ passwordAutocomplete(registering) } minlength="12" maxlength="128" placeholder="At least 12 characters" class="field"/>
			if registering {
				<p class="mt-2 text-xs text-[var(--muted)]">Use at least 12 characters and a unique password.</p>
			}
		</div>
		@Feedback(message)
		<button type="submit" class="btn-primary w-full">
			<span>{ submitLabel }</span>
			<span class="htmx-indicator ml-2" aria-hidden="true">Working…</span>
		</button>
	</form>
}

