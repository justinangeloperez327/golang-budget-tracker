package views

import (
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/accounts"
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/debts"
)

templ DebtsPage(plans []debts.Plan, installments []debts.Installment, history []debts.Payment, wallets []accounts.Account, csrf,createKey,today,message string) {
 @Document("Debts and installments", DebtsContent(plans,installments,history,wallets,csrf,createKey,today,message))
}
templ DebtsContent(plans []debts.Plan,installments []debts.Installment,history []debts.Payment,wallets []accounts.Account,csrf,createKey,today,message string){
 <div class="min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
  <aside class="hidden border-r border-[var(--border)] bg-[var(--panel)] px-5 py-7 lg:block">
   <a href="/dashboard" class="mb-12 flex items-center gap-3 font-semibold"><span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-white">B</span> Budget Tracker</a>
   <nav aria-label="Main navigation" class="space-y-2">
    <a href="/dashboard" class="block rounded-lg px-4 py-3 text-sm">Dashboard</a>
    <a href="/accounts" class="block rounded-lg px-4 py-3 text-sm">Accounts & wallets</a>
    <a href="/transactions" class="block rounded-lg px-4 py-3 text-sm">Transactions</a>
    <a href="/transfers" class="block rounded-lg px-4 py-3 text-sm">Transfers & reconciliation</a>
    <a href="/budgets" class="block rounded-lg px-4 py-3 text-sm">Monthly budgets</a>
    <a href="/recurring" class="block rounded-lg px-4 py-3 text-sm">Bills & subscriptions</a>
    <a href="/debts" aria-current="page" class="block rounded-lg bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">Debts & installments</a>
    <a href="/savings" class="block rounded-lg px-3 py-2 text-sm">Savings goals</a>
    <a href="/remittances" class="block rounded-lg px-3 py-2 text-sm">Remittances</a>
   </nav>
  </aside>
  <div class="min-w-0">
   <header class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-5 py-4 sm:px-8">
    <details class="relative lg:hidden">
     <summary class="cursor-pointer rounded-lg border border-[var(--border)] px-3 py-2 text-sm" aria-label="Open navigation">Menu</summary>
     <nav aria-label="Mobile navigation" class="absolute z-10 mt-2 w-64 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-3 shadow-lg">
      <a class="block rounded-lg px-3 py-2 text-sm" href="/dashboard">Dashboard</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/accounts">Accounts & wallets</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/transactions">Transactions</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/transfers">Transfers</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/budgets">Budgets</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/recurring">Bills</a>
      <a class="block rounded-lg px-3 py-2 text-sm font-semibold" href="/debts">Debts & installments</a>
    <a href="/savings" class="block rounded-lg px-3 py-2 text-sm">Savings goals</a>
    <a href="/remittances" class="block rounded-lg px-3 py-2 text-sm">Remittances</a>
     </nav>
    </details>
    <p class="font-semibold">Personal workspace</p>
    <div class="flex items-center gap-2">
     <button type="button" data-theme-toggle aria-label="Toggle dark mode" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Theme</button>
     <form method="post" action="/logout"><input type="hidden" name="csrf_token" value={csrf}/><button type="submit" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Sign out</button></form>
    </div>
   </header>
   <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">Debt management · Group 12</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Loans & installments</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">Track an existing loan liability and pay monthly installments. The principal reduces debt; interest is an expense. A loan plan does not create new borrowed money.</p>
    @DebtsFeedback(message)
    <div class="mt-7 grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
     <div class="space-y-6">
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Outstanding debt</h2>
       if len(plans)==0{
        <p class="mt-3 text-sm text-[var(--muted)]">No loan plans yet. Create a loan account with its outstanding amount under Accounts first.</p>
       }else{
        <ul class="mt-3 divide-y divide-[var(--border)]">
         for _,p:=range plans{
          <li class="py-4">
           <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
             <p class="font-semibold">{p.Name}</p>
             <p class="mt-1 text-sm text-[var(--muted)]">{p.LoanName} · paid from {p.FundingName}</p>
             <p class="mt-1 text-xs text-[var(--muted)]">{p.Months} installments · {p.AnnualRateBps} basis points APR · {p.Completed} paid</p>
            </div>
            <div class="text-right">
             <p class="text-xs text-[var(--muted)]">Outstanding principal</p>
             <p class="font-semibold tabular-nums">{p.Currency} {accounts.FormatSignedMinor(p.OutstandingMinor)}</p>
            </div>
           </div>
          </li>
         }
        </ul>
       }
      </section>
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Installment schedule</h2>
       <p class="mt-2 text-xs text-[var(--muted)]">Fixed principal per month, declining-balance interest; dates are anchored to the original due day. Pay installments in order, in full. The displayed interest is the scheduled amount, not daily accrued interest.</p>
       if len(installments)==0{
        <p class="mt-4 text-sm text-[var(--muted)]">No installments scheduled.</p>
       }else{
        <div class="mt-4 space-y-3">
         for _,i:=range installments{
          <div class="rounded-lg border border-[var(--border)] p-4">
           <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
             <p class="font-medium">Installment {i.Number} · {i.DueOn}</p>
             <p class="mt-1 text-sm text-[var(--muted)]">Principal {accounts.FormatMinor(i.PrincipalMinor)} + interest {accounts.FormatMinor(i.InterestMinor)}</p>
             <p class="mt-1 text-xs text-[var(--muted)]">{i.Status}</p>
            </div>
            <p class="font-semibold tabular-nums">{i.Currency} {accounts.FormatMinor(i.AmountMinor)}</p>
           </div>
           if i.Status=="pending"{
            <form action="/debts/payments" method="post" hx-post="/debts/payments" hx-target="#debts-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-3 flex flex-wrap items-end gap-3">
             <input type="hidden" name="csrf_token" value={csrf}/>
             <input type="hidden" name="request_key" value={i.PayKey}/>
             <input type="hidden" name="plan_id" value={i.PlanID}/>
             <input type="hidden" name="installment_id" value={i.ID}/>
             <label class="text-xs font-medium">Payment date
              <input class="field mt-1" type="date" name="paid_on" required value={today}/>
             </label>
             <button class="btn-primary" type="submit">Pay installment <span class="htmx-indicator">Saving…</span></button>
            </form>
           }
          </div>
         }
        </div>
       }
      </section>
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Payment history</h2>
       if len(history)==0{
        <p class="mt-3 text-sm text-[var(--muted)]">No loan payments yet.</p>
       }else{
        <ul class="mt-3 divide-y divide-[var(--border)]">
         for _,p:=range history{
          <li class="flex flex-wrap justify-between gap-3 py-3 text-sm">
           <div>
            <p class="font-medium">{p.PlanName} · installment {p.Number}</p>
            <p class="mt-1 text-xs text-[var(--muted)]">{p.PaidOn} · principal {accounts.FormatMinor(p.PrincipalMinor)} · interest {accounts.FormatMinor(p.InterestMinor)}</p>
           </div>
           <p class="font-semibold tabular-nums">{p.Currency} {accounts.FormatMinor(p.AmountMinor)}</p>
          </li>
         }
        </ul>
       }
      </section>
     </div>
     <section class="self-start rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
      <h2 class="text-lg font-semibold">Create loan plan</h2>
      <p class="mt-2 text-xs text-[var(--muted)]">The starting principal is read from the existing loan account ledger. No new liability or cash is posted at setup.</p>
      <form action="/debts" method="post" hx-post="/debts" hx-target="#debts-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-5 space-y-4">
       <input type="hidden" name="csrf_token" value={csrf}/>
       <input type="hidden" name="request_key" value={createKey}/>
       <label class="block text-sm font-medium">Loan name
        <input class="field mt-1" name="name" maxlength="100" required placeholder="e.g. Personal loan"/>
       </label>
       <label class="block text-sm font-medium">Existing loan account
        <select name="loan_account_id" class="field mt-1" required>
         <option value="">Choose loan account</option>
         for _,w:=range wallets{
          if w.Kind=="loan"&&!w.Archived{
           <option value={w.ID}>{w.Name} · {w.Currency} · {accounts.FormatSignedMinor(w.LedgerMinor)} owed</option>
          }
         }
        </select>
       </label>
       <label class="block text-sm font-medium">Repay from
        <select class="field mt-1" name="funding_account_id" required>
         <option value="">Choose bank or wallet</option>
         for _,w:=range wallets{
          if !w.Archived && w.Kind!="loan" && w.Kind!="credit"{
           <option value={w.ID}>{w.Name} · {w.Currency}</option>
          }
         }
        </select>
       </label>
       <label class="block text-sm font-medium">Annual interest rate (APR %)
        <input class="field mt-1" name="apr" inputmode="decimal" value="0.00" pattern="[0-9]{1,4}(\.[0-9]{1,2})?" required/>
       </label>
       <label class="block text-sm font-medium">Number of monthly installments (1–360)
        <input class="field mt-1" name="months" type="number" min="1" max="360" value="12" required/>
       </label>
       <label class="block text-sm font-medium">First due date
        <input class="field mt-1" name="first_due_on" type="date" value={today} min="2000-01-01" max="2100-12-31" required/>
       </label>
       <button type="submit" class="btn-primary w-full">Create installment plan <span class="htmx-indicator">Saving…</span></button>
      </form>
     </section>
    </div>
   </main>
  </div>
 </div>
}
templ DebtsFeedback(message string){
 <div id="debts-feedback" role="status" aria-live="polite" class="mt-4 min-h-5 text-sm text-rose-600">
  if message!=""{
   <p>{message}</p>
  }
 </div>
}
