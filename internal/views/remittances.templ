package views

import (
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/accounts"
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/remittances"
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/transfers"
)

templ RemittancesPage(orders []remittances.Order, wallets []accounts.Account, csrf, key, today, message string) {
 @Document("AED to PHP remittances",RemittancesContent(orders,wallets,csrf,key,today,message))
}
templ RemittancesContent(orders []remittances.Order, wallets []accounts.Account, csrf, key, today, message string) {
 <div class="min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
  <aside class="hidden border-r border-[var(--border)] bg-[var(--panel)] px-5 py-7 lg:block">
   <a href="/dashboard" class="mb-12 flex items-center gap-3 font-semibold"><span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-white">B</span> Budget Tracker</a>
   <nav aria-label="Main navigation" class="space-y-2">
    <a href="/dashboard" class="block rounded-lg px-4 py-3 text-sm">Dashboard</a>
    <a href="/accounts" class="block rounded-lg px-4 py-3 text-sm">Accounts & wallets</a>
    <a href="/transactions" class="block rounded-lg px-4 py-3 text-sm">Transactions</a>
    <a href="/transfers" class="block rounded-lg px-4 py-3 text-sm">Transfers & reconciliation</a>
    <a href="/budgets" class="block rounded-lg px-4 py-3 text-sm">Monthly budgets</a>
    <a href="/recurring" class="block rounded-lg px-4 py-3 text-sm">Bills & subscriptions</a>
    <a href="/debts" class="block rounded-lg px-4 py-3 text-sm">Debts & installments</a>
    <a href="/savings" class="block rounded-lg px-4 py-3 text-sm">Savings goals</a>
    <a href="/remittances" aria-current="page" class="block rounded-lg bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">Remittances</a>
   </nav>
  </aside>
  <div class="min-w-0">
   <header class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-5 py-4 sm:px-8">
    <details class="relative lg:hidden">
     <summary class="cursor-pointer rounded-lg border border-[var(--border)] px-3 py-2 text-sm" aria-label="Open navigation">Menu</summary>
     <nav aria-label="Mobile navigation" class="absolute z-10 mt-2 w-64 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-3 shadow-lg">
      <a class="block rounded-lg px-3 py-2 text-sm" href="/dashboard">Dashboard</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/accounts">Accounts</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/transactions">Transactions</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/transfers">Transfers</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/budgets">Budgets</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/recurring">Bills</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/debts">Debts</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/savings">Savings</a>
      <a class="block rounded-lg px-3 py-2 text-sm font-semibold" href="/remittances">Remittances</a>
     </nav>
    </details>
    <p class="font-semibold">Personal workspace</p>
    <div class="flex items-center gap-2">
     <button type="button" data-theme-toggle aria-label="Toggle dark mode" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Theme</button>
     <form method="post" action="/logout"><input type="hidden" name="csrf_token" value={csrf}/><button type="submit" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Sign out</button></form>
    </div>
   </header>
   <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">International movement · Group 14</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">AED → PHP remittances</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">Plan an internal UAE-to-Philippines money movement. Pending orders do not change balances. “Settle in ledger” records both sides using the existing Group 9 engine; it does not send money or verify an external bank transfer.</p>
    @RemittanceFeedback(message)
    <div class="mt-7 grid gap-6 xl:grid-cols-[minmax(0,1fr)_350px]">
     <div class="space-y-6">
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Remittance history</h2>
       if len(orders)==0 {
        <p class="mt-3 text-sm text-[var(--muted)]">No remittances recorded yet.</p>
       } else {
        <ul class="mt-4 divide-y divide-[var(--border)]">
         for _,o:=range orders {
          <li class="py-5">
           <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
             <p class="font-semibold">{o.FromName} → {o.ToName}</p>
             <p class="mt-1 text-xs text-[var(--muted)]">Requested {o.RequestedOn} · {o.Status}</p>
            </div>
            <div class="text-right">
             <p class="font-semibold tabular-nums">AED {accounts.FormatMinor(o.SendMinor)} → PHP {accounts.FormatMinor(o.ReceiveMinor)}</p>
             <p class="mt-1 text-xs text-[var(--muted)]">Fee AED {accounts.FormatMinor(o.FeeMinor)}</p>
            </div>
           </div>
           <div class="mt-3 grid gap-1 text-xs text-[var(--muted)] sm:grid-cols-2">
            <p>Quoted: 1 AED = {transfers.RateText(o.RateUnits)} PHP</p>
            <p>Effective after fees: {transfers.RateText(o.EffectiveRateUnits)} PHP / AED</p>
           </div>
           if o.Note!="" {
            <p class="mt-2 text-sm">{o.Note}</p>
           }
           if o.Status=="settled" {
            <p class="mt-2 text-xs text-[var(--muted)]">Ledger settled {o.ResolvedOn} · Group 9 transfer {o.TransferID}</p>
           } else if o.Status=="cancelled" {
            <p class="mt-2 text-xs text-[var(--muted)]">Cancelled {o.ResolvedOn} — no ledger transfer posted</p>
           } else {
            <div class="mt-4 flex flex-wrap items-end gap-3">
             <form method="post" action="/remittances/resolve" hx-post="/remittances/resolve" hx-target="#remittance-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="flex flex-wrap items-end gap-2">
              <input type="hidden" name="csrf_token" value={csrf}/>
              <input type="hidden" name="request_key" value={o.SettleKey}/>
              <input type="hidden" name="order_id" value={o.ID}/>
              <input type="hidden" name="action" value="settled"/>
              <label class="text-xs font-medium">Settlement date
               <input type="date" class="field mt-1" name="settled_on" value={today} min="2000-01-01" max="2100-12-31" required/>
              </label>
              <button class="btn-primary" type="submit">Settle in ledger <span class="htmx-indicator">Saving…</span></button>
             </form>
             <form action="/remittances/resolve" method="post" hx-post="/remittances/resolve" hx-target="#remittance-feedback" hx-swap="outerHTML">
              <input type="hidden" name="csrf_token" value={csrf}/>
              <input type="hidden" name="request_key" value={o.CancelKey}/>
              <input type="hidden" name="order_id" value={o.ID}/>
              <input type="hidden" name="action" value="cancelled"/>
              <input type="hidden" name="settled_on" value={today}/>
              <button type="submit" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Cancel order</button>
             </form>
            </div>
           }
          </li>
         }
        </ul>
       }
      </section>
     </div>
     <section class="self-start rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
      <h2 class="text-lg font-semibold">Create a remittance</h2>
      <p class="mt-2 text-xs text-[var(--muted)]">Quoted FX applies to the amount sent, excluding fees. Effective FX includes fees in the total AED cost.</p>
      <form action="/remittances" method="post" hx-post="/remittances" hx-target="#remittance-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-5 space-y-4">
       <input type="hidden" name="csrf_token" value={csrf}/>
       <input type="hidden" name="request_key" value={key}/>
       <label class="block text-sm font-medium">From UAE account · AED
        <select class="field mt-1" name="source_account_id" required>
         <option value="">Select funding account</option>
         for _,w:=range wallets{
          if !w.Archived&&w.Currency=="AED"&&w.Kind!="loan"&&w.Kind!="credit"{
           <option value={w.ID}>{w.Name} · AED {accounts.FormatSignedMinor(w.LedgerMinor)}</option>
          }
         }
        </select>
       </label>
       <label class="block text-sm font-medium">To Philippine account · PHP
        <select class="field mt-1" name="destination_account_id" required>
         <option value="">Select receiving account</option>
         for _,w:=range wallets{
          if !w.Archived&&w.Currency=="PHP"&&w.Kind!="loan"&&w.Kind!="credit"{
           <option value={w.ID}>{w.Name} · PHP {accounts.FormatSignedMinor(w.LedgerMinor)}</option>
          }
         }
        </select>
       </label>
       <label class="block text-sm font-medium">AED amount sent (excluding fee)
        <input class="field mt-1" name="send" inputmode="decimal" required placeholder="100.00" pattern="[0-9]{1,12}(\.[0-9]{1,2})?"/>
       </label>
       <label class="block text-sm font-medium">AED transfer fee
        <input class="field mt-1" name="fee" inputmode="decimal" value="0.00" pattern="[0-9]{1,12}(\.[0-9]{1,2})?"/>
       </label>
       <label class="block text-sm font-medium">Quoted PHP per 1 AED
        <input class="field mt-1" name="rate" inputmode="decimal" required placeholder="15.50000000" pattern="[0-9]{1,7}(\.[0-9]{1,8})?"/>
       </label>
       <label class="block text-sm font-medium">PHP actually received
        <input class="field mt-1" name="receive" inputmode="decimal" required placeholder="1550.00" pattern="[0-9]{1,12}(\.[0-9]{1,2})?"/>
       </label>
       <p class="text-xs text-[var(--muted)]">Received must equal the quoted rate multiplied by the amount sent, rounded to centavos.</p>
       <label class="block text-sm font-medium">Order date
        <input class="field mt-1" name="requested_on" type="date" value={today} min="2000-01-01" max="2100-12-31" required/>
       </label>
       <label class="block text-sm font-medium">Reference note (optional)
        <input name="note" class="field mt-1" maxlength="500" placeholder="e.g. Family bank transfer"/>
       </label>
       <button type="submit" class="btn-primary w-full">Save pending remittance <span class="htmx-indicator">Saving…</span></button>
      </form>
     </section>
    </div>
   </main>
  </div>
 </div>
}
templ RemittanceFeedback(message string){
 <div id="remittance-feedback" role="status" aria-live="polite" class="mt-4 min-h-5 text-sm text-rose-600">
  if message!="" {
   <p>{message}</p>
  }
 </div>
}
