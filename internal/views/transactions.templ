package views

import (
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/accounts"
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/transactions"
)

templ TransactionsPage(wallets []accounts.Account, categories []transactions.Category, records []transactions.Record, expenses []transactions.Record, filter transactions.Filter, csrf string, key string, day string, message string) {
 @Document("Transactions", TransactionsContent(wallets,categories,records,expenses,filter,csrf,key,day,message))
}

templ TransactionsContent(wallets []accounts.Account, categories []transactions.Category, records []transactions.Record, expenses []transactions.Record, filter transactions.Filter, csrf string, key string, day string, message string) {
 <div class="min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
  <aside class="hidden border-r border-[var(--border)] bg-[var(--panel)] px-5 py-7 lg:block">
   <a href="/dashboard" class="mb-12 flex items-center gap-3 font-semibold">
    <span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-white">B</span> Budget Tracker
   </a>
   <nav aria-label="Main navigation" class="space-y-2">
    <a href="/dashboard" class="block rounded-lg px-4 py-3 text-sm">Dashboard</a>
    <a href="/accounts" class="block rounded-lg px-4 py-3 text-sm">Accounts & wallets</a>
    <a href="/transactions" aria-current="page" class="block rounded-lg bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">Transactions</a>
    <a href="/transfers" class="block rounded-lg px-4 py-3 text-sm">Transfers & reconciliation</a>
    <a href="/budgets" class="block rounded-lg px-4 py-3 text-sm">Monthly budgets</a>
    <a href="/recurring" class="block rounded-lg px-3 py-2 text-sm">Bills & subscriptions</a>
    <a href="/debts" class="block rounded-lg px-3 py-2 text-sm">Debts &amp; installments</a>
   </nav>
  </aside>
  <div class="min-w-0">
   <header class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-5 py-4 sm:px-8">
    <details class="relative lg:hidden">
     <summary class="cursor-pointer rounded-lg border border-[var(--border)] px-3 py-2 text-sm" aria-label="Open navigation">Menu</summary>
     <nav aria-label="Mobile navigation" class="absolute z-10 mt-2 w-52 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-3 shadow-lg">
      <a href="/dashboard" class="block rounded-lg px-3 py-2 text-sm">Dashboard</a>
      <a href="/accounts" class="block rounded-lg px-3 py-2 text-sm">Accounts & wallets</a>
      <a href="/transactions" class="block rounded-lg px-3 py-2 text-sm font-semibold">Transactions</a>
      <a href="/transfers" class="block rounded-lg px-3 py-2 text-sm">Transfers & reconciliation</a>
     <a href="/budgets" class="block rounded-lg px-3 py-2 text-sm">Monthly budgets</a>
      <a href="/recurring" class="block rounded-lg px-3 py-2 text-sm">Bills & subscriptions</a>
    <a href="/debts" class="block rounded-lg px-3 py-2 text-sm">Debts &amp; installments</a>
     </nav>
    </details>
    <p class="font-semibold">Personal workspace</p>
    <div class="flex items-center gap-2">
     <button type="button" data-theme-toggle aria-label="Toggle dark mode" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Theme</button>
     <form method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Sign out</button></form>
    </div>
   </header>
   <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">Financial activity · Group 8</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Income & expenses</h1>
    <p class="mt-2 text-sm text-[var(--muted)]">Each entry posts to a balanced AED or PHP ledger. Credit-card expenses increase the amount owed; refunds restore the original account and category.</p>
    <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(300px,350px)]">
     <div class="min-w-0 space-y-6">
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Find transactions</h2>
       <form action="/transactions" method="get" hx-get="/transactions" hx-target="#transactions-list" hx-swap="outerHTML" class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="text-sm">Search note, account or category <input name="q" class="field mt-1" value={ filter.Query } maxlength="100" placeholder="e.g. groceries"/></label>
        <label class="text-sm">Type
         <select name="kind" class="field mt-1">
          <option value="">All types</option>
          <option value="income" selected?={ filter.Kind=="income" }>Income</option>
          <option value="expense" selected?={ filter.Kind=="expense" }>Expense</option>
          <option value="refund" selected?={ filter.Kind=="refund" }>Refund</option>
         </select>
        </label>
        <label class="text-sm">From <input type="date" name="from" class="field mt-1" value={ filter.From }/></label>
        <label class="text-sm">To <input type="date" name="to" class="field mt-1" value={ filter.To }/></label>
        <label class="text-sm sm:col-span-2">Account
         <select name="account" class="field mt-1">
          <option value="">All accounts</option>
          for _, wallet := range wallets {
           <option value={ wallet.ID } selected?={ filter.AccountID==wallet.ID }>{ wallet.Name } ({ wallet.Currency })</option>
          }
         </select>
        </label>
        <button type="submit" class="btn-primary sm:col-span-2">Search <span class="htmx-indicator">Searching…</span></button>
       </form>
      </section>
      @TransactionsList(records,filter)
     </div>
     <div class="space-y-5">
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Record a transaction</h2>
       <p class="mt-2 text-sm text-[var(--muted)]">Choose an account and matching category currency. Add category splits as needed.</p>
       <form action="/transactions" method="post" hx-post="/transactions" hx-target="#transaction-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-5 space-y-4">
        <input type="hidden" name="csrf_token" value={ csrf }/>
        <input type="hidden" name="request_key" value={ key }/>
        <label class="block text-sm font-medium">Transaction type
         <select class="field mt-1" name="kind" required>
          <option value="expense">Expense</option>
          <option value="income">Income</option>
          <option value="refund">Refund of an expense</option>
         </select>
        </label>
        <label class="block text-sm font-medium">Account
         <select class="field mt-1" name="account_id" required>
          <option value="">Select an account</option>
          for _, wallet := range wallets {
           if !wallet.Archived && wallet.Kind!="loan" {
            <option value={ wallet.ID }>{ wallet.Name } · { wallet.Currency } · { accounts.KindLabel(wallet.Kind) }</option>
           }
          }
         </select>
        </label>
        <label class="block text-sm font-medium">Original expense (refund only)
         <select class="field mt-1" name="refund_of">
          <option value="">Not a refund</option>
          for _, original := range expenses {
           <option value={ original.ID }>{ original.OccurredOn.Format("2006-01-02") } · { original.AccountName } · { original.Currency } { accounts.FormatMinor(original.TotalMinor) }</option>
          }
         </select>
        </label>
        <label class="block text-sm font-medium">Date
         <input type="date" class="field mt-1" name="occurred_on" value={ day } required/>
        </label>
        <label class="block text-sm font-medium">Note
         <input type="text" class="field mt-1" name="note" maxlength="500" placeholder="Merchant or details"/>
        </label>
        <fieldset class="space-y-3">
         <legend class="text-sm font-semibold">Category allocations (max. 4 on this form)</legend>
         for i := 0; i < 4; i++ {
          <div class="grid grid-cols-[minmax(0,1fr)_110px] gap-2">
           <label class="text-xs">Category { i+1 }
            <select name="category_id" class="field mt-1">
             <option value="">Select category</option>
             for _, category := range categories {
              <option value={ category.ID }>{ category.Name } · { category.Currency } · { category.Kind }{ archivedSuffix(category.Archived) }</option>
             }
            </select>
           </label>
           <label class="text-xs">Amount
            <input name="split_amount" type="text" inputmode="decimal" class="field mt-1" placeholder="0.00" pattern="[0-9]{1,12}(\.[0-9]{1,2})?"/>
           </label>
          </div>
         }
        </fieldset>
        @TransactionsFeedback(message)
        <button class="btn-primary w-full" type="submit">Save transaction <span class="htmx-indicator">Saving…</span></button>
       </form>
      </section>
      <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
       <h2 class="text-lg font-semibold">Create category</h2>
       <form method="post" action="/categories" class="mt-4 space-y-3">
        <input type="hidden" name="csrf_token" value={ csrf }/>
        <label class="block text-sm">Name <input class="field mt-1" name="name" maxlength="80" required placeholder="e.g. Groceries"/></label>
        <label class="block text-sm">Type
         <select class="field mt-1" name="kind"><option value="expense">Expense</option><option value="income">Income</option></select>
        </label>
        <label class="block text-sm">Currency
         <select class="field mt-1" name="currency"><option value="AED">AED</option><option value="PHP">PHP</option></select>
        </label>
        <button class="btn-primary w-full" type="submit">Add category</button>
       </form>
       if len(categories)>0 {
        <h3 class="mt-6 text-sm font-semibold">Existing categories</h3>
        <ul class="mt-2 space-y-2">
         for _, c := range categories {
          <li class="flex items-center justify-between gap-2 text-xs">
           <span>{ c.Name } · { c.Currency } · { c.Kind }{ archivedSuffix(c.Archived) }</span>
           if !c.Archived {
            <form method="post" action={ "/categories/"+c.ID+"/archive" }>
             <input name="csrf_token" type="hidden" value={ csrf }/>
             <button class="text-blue-600 hover:underline" type="submit" aria-label={ "Archive category "+c.Name }>Archive</button>
            </form>
           }
          </li>
         }
        </ul>
       }
      </section>
     </div>
    </div>
   </main>
  </div>
 </div>
}

templ TransactionsFeedback(message string) {
 <div id="transaction-feedback" role="status" aria-live="polite" class="min-h-6 text-sm text-rose-600 dark:text-rose-300">
  if message != "" {
   <p>{ message }</p>
  }
 </div>
}

templ TransactionsList(records []transactions.Record, filter transactions.Filter) {
 <section id="transactions-list" aria-live="polite" class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
  <h2 class="text-lg font-semibold">Transaction history</h2>
  if len(records)==0 {
   <p class="mt-4 text-sm text-[var(--muted)]">No matching transactions yet. Create a category and record your first income or expense.</p>
  } else {
   <ul class="mt-4 divide-y divide-[var(--border)]">
    for _, r := range records {
     <li class="flex flex-wrap items-start justify-between gap-3 py-4">
      <div class="min-w-0">
       <p class="font-medium">{ r.Categories }</p>
       <p class="mt-1 text-sm text-[var(--muted)]">{ r.AccountName } · { r.OccurredOn.Format("2006-01-02") } · { r.Kind }</p>
       if r.Note != "" {
        <p class="mt-1 text-sm">{ r.Note }</p>
       }
       if r.RefundOf != "" {
        <p class="mt-1 text-xs text-[var(--muted)]">Linked refund</p>
       }
      </div>
      <p class="font-semibold tabular-nums">{ r.Currency } { accounts.FormatMinor(r.TotalMinor) }</p>
     </li>
    }
   </ul>
   <div class="mt-4 flex items-center justify-between text-sm">
    if filter.Page>0 {
     <a class="text-blue-600 hover:underline" href={ transactionsPageURL(filter,filter.Page-1) }>Previous</a>
    } else {
     <span></span>
    }
    if len(records)==25 {
     <a class="text-blue-600 hover:underline" href={ transactionsPageURL(filter,filter.Page+1) }>Next</a>
    }
   </div>
  }
 </section>
}
