package views

import (
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/accounts"
 "github.com/justinangeloperez327/golang-budget-tracker/internal/modules/budgets"
)

templ BudgetsPage(plan budgets.Overview, cats []budgets.Category, csrf string, allocationKey string, policyKey string, message string) {
 @Document("Monthly budgets", BudgetsContent(plan,cats,csrf,allocationKey,policyKey,message))
}
templ BudgetsContent(plan budgets.Overview,cats []budgets.Category,csrf string,allocationKey string,policyKey string,message string){
 <div class="min-h-screen lg:grid lg:grid-cols-[248px_1fr]">
  <aside class="hidden border-r border-[var(--border)] bg-[var(--panel)] px-5 py-7 lg:block">
   <a href="/dashboard" class="mb-12 flex items-center gap-3 font-semibold"><span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 text-white">B</span>Budget Tracker</a>
   <nav aria-label="Main navigation" class="space-y-2">
    <a href="/dashboard" class="block rounded-lg px-4 py-3 text-sm">Dashboard</a>
    <a href="/accounts" class="block rounded-lg px-4 py-3 text-sm">Accounts & wallets</a>
    <a href="/transactions" class="block rounded-lg px-4 py-3 text-sm">Transactions</a>
    <a href="/transfers" class="block rounded-lg px-4 py-3 text-sm">Transfers & reconciliation</a>
    <a href="/budgets" aria-current="page" class="block rounded-lg bg-blue-50 px-4 py-3 text-sm font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">Monthly budgets</a>
    <a href="/recurring" class="block rounded-lg px-3 py-2 text-sm">Bills & subscriptions</a>
    <a href="/debts" class="block rounded-lg px-3 py-2 text-sm">Debts &amp; installments</a>
    <a href="/savings" class="block rounded-lg px-3 py-2 text-sm">Savings goals</a>
   </nav>
  </aside>
  <div class="min-w-0">
   <header class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--panel)] px-5 py-4 sm:px-8">
    <details class="relative lg:hidden">
     <summary class="cursor-pointer rounded-lg border border-[var(--border)] px-3 py-2 text-sm" aria-label="Open navigation">Menu</summary>
     <nav aria-label="Mobile navigation" class="absolute z-10 mt-2 w-64 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-3 shadow-lg">
      <a class="block rounded-lg px-3 py-2 text-sm" href="/dashboard">Dashboard</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/accounts">Accounts & wallets</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/transactions">Transactions</a>
      <a class="block rounded-lg px-3 py-2 text-sm" href="/transfers">Transfers</a>
      <a class="block rounded-lg px-3 py-2 text-sm font-semibold" href="/budgets">Monthly budgets</a>
      <a href="/recurring" class="block rounded-lg px-3 py-2 text-sm">Bills & subscriptions</a>
    <a href="/debts" class="block rounded-lg px-3 py-2 text-sm">Debts &amp; installments</a>
    <a href="/savings" class="block rounded-lg px-3 py-2 text-sm">Savings goals</a>
     </nav>
    </details>
    <p class="font-semibold">Personal workspace</p>
    <div class="flex items-center gap-2">
     <button type="button" data-theme-toggle aria-label="Toggle dark mode" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Theme</button>
     <form method="post" action="/logout"><input type="hidden" name="csrf_token" value={ csrf }/><button type="submit" class="rounded-lg border border-[var(--border)] px-3 py-2 text-sm">Sign out</button></form>
    </div>
   </header>
   <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">Budget planning · Group 10</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Monthly budgets</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">Plan AED and PHP separately. Actuals include expense splits less refunds in the month posted. Transfers, opening balances, credit-card repayments and reconciliation are not spending.</p>
    <form method="get" action="/budgets" hx-get="/budgets" hx-push-url="true" hx-target="#budget-main" hx-swap="outerHTML" class="mt-6 flex flex-wrap items-end gap-3">
     <label class="text-sm font-medium">Month
      <input class="field mt-1" name="month" type="month" min="2000-01" max="2100-12" value={ plan.Month } required/>
     </label>
     <label class="text-sm font-medium">Currency
      <select class="field mt-1" name="currency" required>
       <option value="AED" selected?={plan.Currency=="AED"}>AED — UAE dirham</option>
       <option value="PHP" selected?={plan.Currency=="PHP"}>PHP — Philippine peso</option>
      </select>
     </label>
     <button type="submit" class="btn-primary">View month <span class="htmx-indicator">Loading…</span></button>
    </form>
    @BudgetMain(plan,cats,csrf,allocationKey,policyKey,message)
   </main>
  </div>
 </div>
}
templ BudgetMain(plan budgets.Overview,cats []budgets.Category,csrf string,allocationKey string,policyKey string,message string){
 <div id="budget-main" class="mt-7">
  <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
   @BudgetStat("Allocated",plan.Currency,plan.PlannedMinor)
   @BudgetStat("Rolled over",plan.Currency,plan.CarriedMinor)
   @BudgetStat("Net spent",plan.Currency,plan.ActualMinor)
   <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-[var(--muted)]">Remaining</p>
    <p class="mt-3 text-xl font-semibold tabular-nums">{ plan.Currency } { accounts.FormatSignedMinor(plan.RemainingMinor) }</p>
    if plan.Overspent {
     <p class="mt-2 text-xs font-semibold text-rose-600" role="status">Over budget</p>
    } else {
     <p class="mt-2 text-xs text-[var(--muted)]">Available after spending</p>
    }
   </section>
  </div>
  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_330px]">
   <section class="min-w-0 rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
    <h2 class="text-lg font-semibold">{ plan.Month } · { plan.Currency } breakdown</h2>
    <p class="mt-2 text-sm text-[var(--muted)]">
     if plan.Policy=="carry_positive" {
      Unused positive category balances roll from the immediately preceding configured month.
     } else {
      No rollover is enabled for this month.
     }
    </p>
    @BudgetRows(plan)
   </section>
   <div class="space-y-5">
    <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
     <h2 class="text-lg font-semibold">Set a category allocation</h2>
     <p class="mt-2 text-sm text-[var(--muted)]">Saving another amount revises the plan; zero clears an allocation. Historical changes remain auditable.</p>
     <form method="post" action="/budgets/allocations" hx-post="/budgets/allocations" hx-target="#budget-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-4 space-y-3">
      <input type="hidden" name="csrf_token" value={csrf}/>
      <input type="hidden" name="request_key" value={allocationKey}/>
      <input type="hidden" name="month" value={plan.Month}/>
      <input type="hidden" name="currency" value={plan.Currency}/>
      <label class="block text-sm font-medium">Expense category
       <select class="field mt-1" name="category_id" required>
        <option value="">Select an expense category</option>
        for _,category:=range cats {
         if !category.Archived {
          <option value={category.ID}>{category.Name}</option>
         }
        }
       </select>
      </label>
      <label class="block text-sm font-medium">Monthly allocation · {plan.Currency}
       <input name="amount" type="text" inputmode="decimal" class="field mt-1" required pattern="[0-9]{1,12}(\.[0-9]{1,2})?" placeholder="250.00"/>
      </label>
      @BudgetFeedback(message)
      <button class="btn-primary w-full" type="submit">Save allocation <span class="htmx-indicator">Saving…</span></button>
     </form>
     if len(cats)==0 {
      <p class="mt-4 text-sm text-[var(--muted)]">Create an expense category under <a href="/transactions" class="text-blue-600 hover:underline">Transactions</a> first.</p>
     }
    </section>
    <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
     <h2 class="text-lg font-semibold">Rollover policy</h2>
     <form method="post" action="/budgets/policy" hx-post="/budgets/policy" hx-target="#budget-feedback" hx-swap="outerHTML" hx-disabled-elt="find button[type='submit']" class="mt-4 space-y-3">
      <input type="hidden" name="csrf_token" value={csrf}/>
      <input type="hidden" name="request_key" value={policyKey}/>
      <input type="hidden" name="month" value={plan.Month}/>
      <input type="hidden" name="currency" value={plan.Currency}/>
      <label class="block text-sm font-medium">Unused allocations
       <select class="field mt-1" name="policy">
        <option value="none" selected?={plan.Policy=="none"}>No rollover</option>
        <option value="carry_positive" selected?={plan.Policy=="carry_positive"}>Carry positive remaining amounts</option>
       </select>
      </label>
      <p class="text-xs text-[var(--muted)]">Only immediately preceding configured months can supply rollover; gaps break the chain. Negative balances never carry as debt.</p>
      <button type="submit" class="btn-primary w-full">Save rollover policy <span class="htmx-indicator">Saving…</span></button>
     </form>
    </section>
   </div>
  </div>
 </div>
}
templ BudgetStat(title string,currency string,minor int64){
 <section class="rounded-xl border border-[var(--border)] bg-[var(--panel)] p-5">
  <p class="text-xs font-semibold uppercase tracking-wider text-[var(--muted)]">{title}</p>
  <p class="mt-3 text-xl font-semibold tabular-nums">{currency} {accounts.FormatSignedMinor(minor)}</p>
 </section>
}
templ BudgetRows(plan budgets.Overview) {
 <div id="budget-rows" aria-live="polite" class="mt-5">
  if len(plan.Rows)==0 {
   <p class="rounded-lg border border-dashed border-[var(--border)] p-5 text-sm text-[var(--muted)]">No budgeted or spent categories yet. Allocate a category to begin.</p>
  } else {
   <div class="overflow-x-auto">
    <table class="w-full min-w-[560px] text-left text-sm">
     <thead>
      <tr class="border-b border-[var(--border)] text-[var(--muted)]">
       <th scope="col" class="py-3 pr-3 font-medium">Category</th>
       <th scope="col" class="py-3 pr-3 font-medium">Allocated</th>
       <th scope="col" class="py-3 pr-3 font-medium">Carry</th>
       <th scope="col" class="py-3 pr-3 font-medium">Net spent</th>
       <th scope="col" class="py-3 font-medium">Remaining</th>
      </tr>
     </thead>
     <tbody>
      for _,r:=range plan.Rows {
       <tr class="border-b border-[var(--border)]">
        <th scope="row" class="py-3 pr-3 font-medium">{r.Name}</th>
        <td class="py-3 pr-3 tabular-nums">{accounts.FormatMinor(r.AllocatedMinor)}</td>
        <td class="py-3 pr-3 tabular-nums">{accounts.FormatMinor(r.CarriedMinor)}</td>
        <td class="py-3 pr-3 tabular-nums">{accounts.FormatSignedMinor(r.ActualMinor)}</td>
        <td class="py-3 tabular-nums">
         if r.Overspent {
          <span class="font-semibold text-rose-600">{accounts.FormatSignedMinor(r.RemainingMinor)} (over)</span>
         } else {
          <span>{accounts.FormatSignedMinor(r.RemainingMinor)}</span>
         }
        </td>
       </tr>
      }
     </tbody>
    </table>
   </div>
  }
 </div>
}
templ BudgetFeedback(message string){
 <div id="budget-feedback" role="status" aria-live="polite" class="min-h-5 text-sm text-rose-600">
  if message!="" {
   <p>{message}</p>
  }
 </div>
}
